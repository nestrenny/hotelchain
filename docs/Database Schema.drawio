="7328-69" style="edgeStyle=orthogonalEdgeStyle;exitX=0.400;exitY=0;exitDx=0;exitDy=0;entryX=0.500;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="7328-54" target="7328-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="852"/><mxPoint x="485" y="852"/></Array></mxGeometry></mxCell><mxCell id="7328-70" style="edgeStyle=orthogonalEdgeStyle;exitX=0.600;exitY=0;exitDx=0;exitDy=0;entryX=0.500;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="7328-54" target="7328-45"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="866"/><mxPoint x="805" y="866"/></Array></mxGeometry></mxCell><mxCell id="7328-71" style="edgeStyle=orthogonalEdgeStyle;exitX=0.800;exitY=0;exitDx=0;exitDy=0;entryX=0.500;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="7328-54" target="7328-52"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="880" y="880"/><mxPoint x="1445" y="880"/></Array></mxGeometry></mxCell><mxCell id="7328-72" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;Navy tables are dimensions (one row per thing). Grey tables are facts (many rows, measured over time).&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; is a table&#x27;s key; &lt;b&gt;FK&lt;/b&gt; is a column that points at another table&#x27;s key.&lt;br&gt;Each line joins a fact&#x27;s FK to a dimension&#x27;s PK: many fact rows to one dimension row (the crow&#x27;s foot is the &#x27;many&#x27; end).&lt;br&gt;Grey solid lines are relationships defined in the Power BI model. Gold dashed lines exist in the data but are left out of the model, because every fact already joins to Property directly.&lt;br&gt;The small text under each name is the lakehouse table it is loaded from." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1E1E1E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1134" width="520" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="28667" name="AI Control Tower"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7524-1" value="AI Control Tower: tables and relationships" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#0F2233;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="34" as="geometry"/></mxCell><mxCell id="7524-2" value="Forecasts&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;&quot;&gt;gold.fact_forecasts&lt;/span&gt;" style="swimlane;html=1;fontStyle=1;fontSize=13;startSize=44;horizontal=1;collapsible=0;rounded=1;arcSize=4;fillColor=#F1F4F7;fontColor=#0F2233;strokeColor=#C9CED3;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="200" y="90" width="250" height="210" as="geometry"/></mxCell><mxCell id="7524-3" value="&lt;b&gt;FK&lt;/b&gt;&amp;nbsp;&amp;nbsp;Date &lt;span style=&quot;color:#8A939B;&quot;&gt;date&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=#FBF3E4;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontColor=#1E1E1E;" vertex="1" parent="7524-2"><mxGeometry x="0" y="44" width="250" height="20" as="geometry"/></mxCell><mxCell id="7524-4" value="&lt;b&gt;FK&lt;/b&gt;&amp;nbsp;&amp;nbsp;Property ID &lt;span style=&quot;color:#8A939B;&quot;&gt;text&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=#FBF3