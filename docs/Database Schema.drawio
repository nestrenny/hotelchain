0;exitY=0;exitDx=0;exitDy=0;entryX=0.333;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="6333-53" target="6333-46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="708" y="838"/><mxPoint x="1083" y="838"/></Array></mxGeometry></mxCell><mxCell id="6333-76" style="edgeStyle=orthogonalEdgeStyle;exitX=0.200;exitY=0;exitDx=0;exitDy=0;entryX=0.667;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="6333-60" target="6333-21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="852"/><mxPoint x="207" y="852"/></Array></mxGeometry></mxCell><mxCell id="6333-77" style="edgeStyle=orthogonalEdgeStyle;exitX=0.400;exitY=0;exitDx=0;exitDy=0;entryX=0.667;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="6333-60" target="6333-32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="866"/><mxPoint x="527" y="866"/></Array></mxGeometry></mxCell><mxCell id="6333-78" style="edgeStyle=orthogonalEdgeStyle;exitX=0.600;exitY=0;exitDx=0;exitDy=0;entryX=0.667;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="6333-60" target="6333-46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="990" y="880"/><mxPoint x="1167" y="880"/></Array></mxGeometry></mxCell><mxCell id="6333-79" style="edgeStyle=orthogonalEdgeStyle;exitX=0.800;exitY=0;exitDx=0;exitDy=0;entryX=0.500;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="6333-60" target="6333-49"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="894"/><mxPoint x="1445" y="894"/></Array></mxGeometry></mxCell><mxCell id="6333-80" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;Navy tables are dimensions (one row per thing). Grey tables are facts (many rows, measured over time).&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; is a table&#x27;s key; &lt;b&gt;FK&lt;/b&gt; is a column that points at another table&#x27;s key.&lt;br&gt;Each line joins a fact&#x27;s FK to a dimension&#x27;s PK: many fact rows to one dimension row (the crow&#x27;s foot is the &#x27;many&#x27; end).&lt;br&gt;Grey solid lines are relationships defined in the Power BI model. Gold dashed lines exist in the data but are left out of the model, because every fact already joins to Property directly.&lt;br&gt;The small text under each name is the lakehouse table it is loaded from." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1E1E1E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1168" width="520" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="28632" name="Restaurants to Spa"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5238-1" value="Restaurants to Spa: tables and relationships" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#0F2233;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="34" as="geometry"/></mxCell><mxCell id="5238-2" value="Restaurant Covers&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;&quot;&gt;gold.fact_restaurant_covers&lt;/span&gt;" style="swimlane;html=1;fontStyle=1;fontSize=13;startSize=44;horizontal=1;coll