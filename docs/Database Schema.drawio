Y=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="5238-58" target="5238-19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="582" y="766"/><mxPoint x="207" y="766"/></Array></mxGeometry></mxCell><mxCell id="5238-77" style="edgeStyle=orthogonalEdgeStyle;exitX=0.500;exitY=0;exitDx=0;exitDy=0;entryX=0.667;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="5238-58" target="5238-30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="645" y="780"/><mxPoint x="527" y="780"/></Array></mxGeometry></mxCell><mxCell id="5238-78" style="edgeStyle=orthogonalEdgeStyle;exitX=0.750;exitY=0;exitDx=0;exitDy=0;entryX=0.667;entryY=1;entryDx=0;entryDy=0;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#5F6B76;strokeWidth=1;" edge="1" parent="1" source="5238-58" target="5238-41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="708" y="794"/><mxPoint x="847" y="794"/></Array></mxGeometry></mxCell><mxCell id="5238-79" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=1;endArrow=ERmandOne;endFill=0;startArrow=ERmany;startFill=0;strokeColor=#B8894A;strokeWidth=1;dashed=1;" edge="1" parent="1" source="5238-47" target="5238-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5238-80" value="&lt;b&gt;How to read this&lt;/b&gt;&lt;br&gt;Navy tables are dimensions (one row per thing). Grey tables are facts (many rows, measured over time).&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; is a table&#x27;s key; &lt;b&gt;FK&lt;/b&gt; is a column that points at another table&#x27;s key.&lt;br&gt;Each line joins a fact&#x27;s FK to a dimension&#x27;s PK: many fact rows to one dimension row (the crow&#x27;s foot is the &#x27;many&#x27; end).&lt;br&gt;Grey solid lines are relationships defined in the Power BI model. Gold dashed lines exist in the data but are left out of the model, because every fact already joins to Property directly.&lt;br&gt;The small text under each name is the lakehouse table it is loaded from." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#1E1E1E;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="40" y="1108" width="520" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="83692" name="Marketing and Finance"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7328-1" value="Marketing and Finance: tables and relationships" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#0F2233;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1100" height="34" as="geometry"/></mxCell><mxCell id="7328-2" value="Marketing&lt;br&gt;&lt;span style=&quot;font-size:9px;font-weight:normal;&quot;&gt;gold.fact_marketing_campaigns&lt;/span&gt;" style="swimlane;html=1;fontStyle=1;fontSize=13;startSize=44;horizontal=1;collapsible=0;rounded=1;arcSize=4;fillColor=#F1F4F7;fontColor=#0F2233;strokeColor=#C9CED3;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="250" height="310" as="geometry"/></mxCell><mxCell id="7328-3" value="&lt;b&gt;FK&lt;/b&gt;&amp;nbsp;&amp;nbsp;Date &lt;span style=&quot;color:#8A939B;&quot;&gt;date&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=#FBF3E4;align=left;verticalAlign=middle;spacingLeft=8;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;fontColor=#1E1E1E;" vertex="1" parent="7328-2"><mxGeometry x="0" y="44" width="250" height="20" as="ge