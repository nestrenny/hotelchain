ref table Marketing
ref table Finance
ref table Budget
ref table Forecasts
ref table Recommendations
ref table Alerts
ref table Models
ref table 'Energy Daily'
ref table 'Energy End Use'
ref table 'Energy Forecast'
ref table 'Device Risk'
ref table 'Contract Reminders'
ref table 'Energy Findings'

ref expression DataFolder
