table Forecasts
	lineageTag: eb22790a-2748-56f7-98a0-9c6ecc434ab8

	measure 'Revenue Forecast' = CALCULATE(SUM('Forecasts'[Forecast Value]), 'Forecasts'[Metric] = "finance_revenue", 'Forecasts'[Forecast Type] = "forecast")
		formatString: \$#,0
		lineageTag: 163c15da-834a-56ee-be42-9a971d89d49f

	measure 'Revenue Forecast Low' = CALCULATE(SUM('Forecasts'[Lower 80]), 'Forecasts'[Metric] = "finance_revenue", 'Forecasts'[Forecast Type] = "forecast")
		formatString: \$#,0
		lineageTag: 7d51ae35-724b-54cb-8789-4198030cff44

	measure 'Revenue Forecast High' = CALCULATE(SUM('Forecasts'[Upper 80]), 'Forecasts'[Metric] = "finance_revenue", 'Forecasts'[Forecast Type] = "forecast")
		formatString: \$#,0
		lineageTag: afb4231b-1fde-5cd9-ba38-639b31544982

	measure 'Revenue Actual (last 90 days)' = CALCULATE(SUM('Forecasts'[Actual Value]), 'Forecasts'[Metric] = "finance_revenue", 'Forecasts'[Forecast Type] = "backtest")
		formatString: \$#,0
		lineageTag: f2cc61ac-773e-5ee9-b3ed-97bdfd2e11e0

	measure 'Revenue Backtest Forecast' = CALCULATE(SUM('Forecasts'[Forecast Value]), 'Forecasts'[Metric] = "finance_revenue", 'Forecasts'[Forecast Type] = "backtest")
		formatString: \$#,0
		lineageTag: ce27dfdf-abd1-5474-a485-7ad650e04fee

	measure 'GOP Forecast' = CALCULATE(SUM('Forecasts'[Forecast Value]), 'Forecasts'[Metric] = "finance_gop", 'Forecasts'[Forecast Type] = "forecast")
		formatString: \$#,0
		lineageTag: 893ef7b9-dd0d-5b5f-9b75-17f1cf8b327b

