table 'Room Revenue'
	lineageTag: 5a624e81-7061-5c1b-a812-3353c1bc7b5b

	measure 'Room Nights' = SUM('Room Revenue'[Room Nights (base)])
		formatString: #,0
		lineageTag: 31715fa6-a1c2-5136-b73b-2282580e4dd9

	measure 'Booked Room Revenue' = SUM('Room Revenue'[Room Revenue USD])
		formatString: \$#,0
		lineageTag: 14d4be2b-bd7f-580c-9464-75996972b290

	measure 'Booked ADR' = DIVIDE([Booked Room Revenue], [Room Nights])
		formatString: \$#,0
		lineageTag: b453242c-a5d1-5f74-8caa-94ce7ae8afed

