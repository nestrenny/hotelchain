	column 'Attributed Revenue USD'
		dataType: double
		formatString: #,0.00
		lineageTag: 7b3479da-7a69-583a-af7d-c3b42fc432f3
		summarizeBy: none
		sourceColumn: attributed_revenue_usd

	column 'New Customers'
		dataType: int64
		formatString: 0
		lineageTag: 030b2263-0977-5a5e-a4ab-2cfc3357a3de
		summarizeBy: none
		sourceColumn: new_customers

	partition Marketing = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "\marketing.parquet"))
				in
				    Source
