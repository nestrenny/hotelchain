table 'Room Occupancy'
	lineageTag: a96e5443-1730-546a-939e-dc91e6f81022

	measure 'Room Type Occupancy' = DIVIDE(SUM('Room Occupancy'[Rooms Sold (base)]), SUM('Room Occupancy'[Rooms Available (base)]))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f71b23cf-389a-5908-a83d-86d42c54f787

	measure 'Room Type Revenue' = SUM('Room Occupancy'[Room Revenue USD])
		formatString: \$#,0
		lineageTag: 66697154-3ab6-5a99-b4cf-b60c713b571e

	measure 'Room Type ADR' = DIVIDE(SUM('Room Occupancy'[Room Revenue USD]), SUM('Room Occupancy'[Rooms Sold (base)]))
		formatString: \$#,0
		lineageTag: 83f2b037-e11b-53e3-a194-7feacdf1eb51

